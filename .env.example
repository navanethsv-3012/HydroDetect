# Backend
PORT=5000
MONGODB_URI=mongodb://localhost:27017/aquasentinel
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# SMTP (Nodemailer) — leave blank to skip email; system will log instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=aquasentinel@yourcompany.com
ALERT_EMAIL_TO=admin@yourcompany.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Simulator
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=5000
SIMULATOR_DEVICE_COUNT=3
